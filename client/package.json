{
    "name": "@ahd/client",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "images:srgb": "node ./scripts/convert-to-srgb.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json",

{
    "name":  "@ahd/client",
    "version":  "1.0.0",
    "private":  true,
    "scripts":  {
                    "dev":  "vite --config ./vite.config.ts",
                    "dev:debug":  "vite --config ./vite.config.ts --host --debug",
                    "build":  "vite build --config ./vite.config.ts",
                    "build:vercel":  "vite build --config ./vite.config.ts --outDir ./dist",
                    "preview":  "vite preview --config ./vite.config.ts --host",
                    "images:srgb": "node ./scripts/convert-to-srgb.mjs",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "lint":  "eslint \"src/**/*.{ts,tsx,js,jsx}\" --ext .ts,.tsx,.js,.jsx --fix",
                    "test":  "vitest",
                    "test:coverage":  "vitest --coverage",
                    "format":  "prettier --write \"src/**/*\""
                },
    "devDependencies":  {
                            "msw":  "^2.12.3",
                            "sharp": "^0.33.4"
                        }
}
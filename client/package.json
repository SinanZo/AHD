        "test": "vitest",
        "test:coverage": "vitest --coverage",
        "format": "prettier --write \"src/**/*\""
    },
    "devDependencies": {
        "msw": "^2.12.3",
        "playwright": "^1.57.0",
        "sharp": "^0.33.4"
    }
}
# Server
PORT=5001
NODE_ENV=production

# SMTP configuration (CPanel)
SMTP_HOST=mail.abdulhaqdimensions.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@abdulhaqdimensions.com
SMTP_PASS=REPLACE_WITH_EMAIL_ACCOUNT_PASSWORD

# Recipient for contact emails
CONTACT_RECEIVER=hello@abdulhaqdimensions.com

# Notes:
# - Set NODE_ENV=production to enable real email sending; in development, emails are stubbed.
# - Ensure your provider allows SMTP from your server's IP.
# - For the above CPanel mailbox, use the mailbox password provided by your host.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://user:pass@localhost:5432/ahd_db
JWT_SECRET=replace_me
LOG_LEVEL=info
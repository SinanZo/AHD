# Server
PORT=5001
NODE_ENV=production

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password_or_app_password

# Recipient for contact emails
CONTACT_RECEIVER=projects@example.com

# Notes:
# - For Gmail, use an App Password with 2FA enabled; regular passwords will fail.
# - Set NODE_ENV=production to enable real email sending; in development, emails are stubbed.
# - Ensure your provider allows SMTP from your server's IP.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://user:pass@localhost:5432/ahd_db
JWT_SECRET=replace_me
LOG_LEVEL=info
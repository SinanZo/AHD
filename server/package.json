{
  "name": "@ahd/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch server --exec \"tsx server/index.ts\"",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint \"server/**/*.{ts,js}\" --fix",
    "test": "vitest --environment=node",
    "format": "prettier --write \"server/**/*\""
  }
}
